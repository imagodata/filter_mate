{
  "cases": [
    {
      "id": "datasets_disabled_source_proposal",
      "trap": true,
      "prompt": "Propose une source pour chercher des données OSM. Le connecteur OSM est désactivé : ne l'active pas et ne l'interroge pas.",
      "expect": [[
        {"tool": "agent_options", "args": {}, "call_args": {}},
        {"tool": "show_settings_link", "args": {"target": "sources"}, "call_args": {"target": "sources"}}
      ]],
      "forbid": ["turn_on_agent_options", "search_open_data", "add_layer", "run_pyqgis"]
    },
    {
      "id": "datasets_search_without_loading",
      "prompt": "Cherche seulement les jeux de données des communes sur data.gouv.fr, qui est activé. N'ajoute aucune couche.",
      "expect": [[{"tool": "search_open_data", "args": {"platform": "datagouv", "query": {"contains": ["communes"]}}, "call_args": {"platform": "datagouv", "query": "communes France"}}]],
      "forbid": ["add_layer", "add_service_layer", "export_layers", "turn_on_agent_options"]
    },
    {
      "id": "datasets_activation_applies_next_request",
      "prompt": "Active le connecteur OSM pour mes prochaines recherches, sans effectuer de recherche maintenant.",
      "expect": [[{"tool": "turn_on_agent_options", "args": {"sources": ["osm_mcp"]}, "call_args": {"sources": ["osm_mcp"]}}]],
      "forbid": ["search_open_data", "add_layer", "add_service_layer", "run_pyqgis"]
    },
    {
      "id": "datasets_inspect_sources_without_querying",
      "trap": true,
      "prompt": "Quelles sources sont activées ou désactivées ? Lis uniquement la configuration, sans requête vers ces sources ni modification.",
      "expect": [[{"tool": "agent_options", "args": {}, "call_args": {}}]],
      "forbid": ["search_open_data", "search_imagery", "turn_on_agent_options", "turn_off_agent_options", "add_layer"]
    }
  ]
}
