{
  "cases": [
    {
      "id": "model_buffer_chain",
      "prompt": "Transforme le buffer de 500 m puis les centroïdes en un modèle réutilisable tampons_routes, ouvre-le dans l’éditeur pour que je choisisse où l’enregistrer.",
      "expect": [
        [
          {
            "tool": "open_model",
            "args": {
              "definition": {
                "contains": [
                  "tampons_routes",
                  "native:buffer",
                  "native:centroids"
                ]
              }
            },
            "call_args": {
              "definition": {
                "name": "tampons_routes",
                "inputs": [
                  {
                    "name": "INPUT",
                    "step": "buffer",
                    "parameter": "INPUT"
                  },
                  {
                    "name": "DISTANCE",
                    "step": "buffer",
                    "parameter": "DISTANCE",
                    "default": 500
                  }
                ],
                "steps": [
                  {
                    "id": "buffer",
                    "algorithm_id": "native:buffer",
                    "parameters": {
                      "INPUT": {
                        "input": "INPUT"
                      },
                      "DISTANCE": {
                        "input": "DISTANCE"
                      },
                      "SEGMENTS": 5
                    }
                  },
                  {
                    "id": "final",
                    "algorithm_id": "native:centroids",
                    "parameters": {
                      "INPUT": {
                        "step": "buffer",
                        "output": "OUTPUT"
                      },
                      "ALL_PARTS": false
                    }
                  }
                ],
                "outputs": [
                  {
                    "name": "RESULT",
                    "step": "final",
                    "output": "OUTPUT"
                  }
                ]
              }
            }
          }
        ]
      ],
      "forbid": [
        "run_pyqgis",
        "run_algorithm",
        "export_layers"
      ]
    },
    {
      "id": "model_blank_editor",
      "prompt": "Ouvre l’éditeur graphique de modèles QGIS avec un nouveau modèle vide.",
      "expect": [
        [
          {
            "tool": "open_model",
            "call_args": {}
          }
        ]
      ],
      "forbid": [
        "run_pyqgis",
        "run_algorithm"
      ]
    },
    {
      "id": "model_filters_are_not_steps",
      "trap": true,
      "prompt": "Mets les filtres actuels des bâtiments dans un modèle Processing.",
      "expect": [],
      "forbid": [
        "open_model",
        "run_pyqgis",
        "run_algorithm"
      ]
    },
    {
      "id": "model_without_expert",
      "expert": false,
      "prompt": "Ouvre l’éditeur de modèles Processing sans activer le mode expert.",
      "expect": [
        [
          {
            "tool": "open_model",
            "call_args": {}
          }
        ]
      ],
      "forbid": [
        "run_pyqgis",
        "run_algorithm"
      ]
    }
  ]
}
