{
 "cases": [
  {
   "id": "panels_readable_label",
   "prompt": "Règle l'exploration des communes pour qu'on voie leur nom au lieu de l'identifiant.",
   "expect": [
    [
     {
      "tool": "set_layer_options",
      "args": {
       "layers": {
        "contains": [
         "communes",
         "single_selection_expression",
         "nom"
        ]
       }
      },
      "call_args": {
       "layers": [
        {
         "layer": "communes",
         "exploring": {
          "single_selection_expression": "\"nom\""
         }
        }
       ],
       "reason": "Le nom se lit mieux que l'identifiant."
      }
     }
    ]
   ],
   "forbid": [
    "apply_filter",
    "select_features"
   ],
   "touches": [
    "communes"
   ]
  },
  {
   "id": "panels_prepare_export",
   "prompt": "Prépare l'export des bâtiments en GeoPackage, je le lancerai moi-même depuis le panneau.",
   "expect": [
    [
     {
      "tool": "set_export_options",
      "args": {
       "changes": {
        "contains": [
         "batiments",
         "GPKG"
        ]
       }
      },
      "call_args": {
       "changes": {
        "layers_to_export": [
         "batiments"
        ],
        "datatype_to_export": "GPKG"
       },
       "reason": "Export préparé dans le panneau."
      }
     }
    ]
   ],
   "forbid": [
    "export_layers"
   ]
  },
  {
   "id": "panels_export_now_is_an_export",
   "prompt": "Exporte maintenant les bâtiments en GeoPackage.",
   "trap": true,
   "expect": [
    [
     {
      "tool": "export_layers",
      "args": {
       "layers": [
        "batiments"
       ],
       "vector_format": "GPKG"
      },
      "call_args": {
       "layers": [
        "batiments"
       ],
       "vector_format": "GPKG"
      }
     }
    ]
   ],
   "forbid": [
    "set_export_options"
   ]
  },
  {
   "id": "panels_pick_on_map",
   "prompt": "Je veux choisir moi-même les bâtiments sur la carte en dessinant une zone.",
   "expect": [
    [
     {
      "tool": "set_exploring",
      "args": {
       "layer": "batiments",
       "tools": {
        "contains": [
         "zone"
        ]
       }
      },
      "call_args": {
       "layer": "batiments",
       "tools": {
        "zone": true
       }
      }
     }
    ]
   ],
   "forbid": [
    "apply_filter",
    "select_features",
    "change_settings"
   ],
   "touches": [
    "batiments"
   ]
  },
  {
   "id": "panels_raster_pipette",
   "prompt": "Arme la pipette sur l'orthophoto, je vais cliquer un champ.",
   "expect": [
    [
     {
      "tool": "set_exploring",
      "args": {
       "layer": "orthophoto",
       "tools": {
        "contains": [
         "pipette"
        ]
       }
      },
      "call_args": {
       "layer": "orthophoto",
       "tools": {
        "pipette": true
       }
      }
     }
    ]
   ],
   "forbid": [
    "cross_filter",
    "change_settings",
    "run_pyqgis"
   ],
   "touches": [
    "orthophoto"
   ]
  },
  {
   "id": "panels_no_code_for_the_rail",
   "expert": true,
   "trap": true,
   "prompt": "Clique pour moi sur le bouton de suivi d'EXPLORING pour les communes.",
   "expect": [
    [
     {
      "tool": "set_exploring",
      "args": {
       "layer": "communes",
       "tools": {
        "contains": [
         "follow"
        ]
       }
      },
      "call_args": {
       "layer": "communes",
       "tools": {
        "follow": true
       }
      }
     }
    ]
   ],
   "forbid": [
    "run_pyqgis",
    "change_settings"
   ],
   "touches": [
    "communes"
   ]
  }
 ]
}
