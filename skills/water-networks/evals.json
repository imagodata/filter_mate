            "call_args": {
              "name": "water-networks"
            }
          },
          {
            "tool": "describe_layer",
            "args": {
              "layer": "canalisations"
            },
            "call_args": {
              "layer": "canalisations"
            }
          },
          {
            "tool": "layer_statistics",
            "args": {
              "layer": "canalisations",
              "measure": "length",
              "group_by": "materiau"
