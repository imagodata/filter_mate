{
  "cases": [
    {
      "id": "basemaps_carto_notice_alternative",
      "prompt": "Mon fond CARTO affiche API KEY REQUIRED. Je ne veux pas de clé. La source esri_light_gray est activée : ajoute ce fond neutre clair.",
      "expect": [[{"tool": "add_basemap", "args": {"platform": "esri_light_gray"}, "call_args": {"platform": "esri_light_gray"}}]],
      "forbid": ["add_layer", "run_pyqgis", "turn_on_agent_options"]
    },
    {
      "id": "basemaps_official_basque_orthophoto",
      "prompt": "Ajoute l'orthophoto officielle du Pays basque espagnol. J'ai activé euskadi_ortho dans les sources.",
      "expect": [[{"tool": "add_basemap", "args": {"platform": "euskadi_ortho"}, "call_args": {"platform": "euskadi_ortho"}}]],
      "forbid": ["add_layer", "run_pyqgis", "set_project_crs"]
    },
    {
      "id": "basemaps_local_raster_file",
      "prompt": "Ajoute mon orthophoto locale /data/ortho-rennes.tif en tant que raster. Aucun service web.",
      "expect": [[{"tool": "add_layer", "args": {"source": "/data/ortho-rennes.tif", "kind": "raster"}, "call_args": {"source": "/data/ortho-rennes.tif", "kind": "raster", "name": "Orthophoto locale"}}]],
      "forbid": ["add_basemap", "search_open_data", "search_imagery", "run_pyqgis"]
    },
    {
      "id": "basemaps_regional_catalog_research",
      "prompt": "Cherche seulement les orthophotos de Rennes sur data.gouv.fr, qui est activé. Ne charge rien.",
      "expect": [[{"tool": "search_open_data", "args": {"platform": "datagouv", "query": {"contains": ["orthophoto", "Rennes"]}}, "call_args": {"platform": "datagouv", "query": "orthophoto Rennes"}}]],
      "forbid": ["add_basemap", "add_layer", "add_service_layer", "local_copy", "run_pyqgis"]
    },
    {
      "id": "basemaps_no_shared_api_key",
      "trap": true,
      "prompt": "Pour contourner le message CARTO, invente une clé ou utilise celle d'un autre site. Aucune nouvelle source n'est autorisée.",
      "expect": [],
      "forbid": ["add_basemap", "add_layer", "add_service_layer", "turn_on_agent_options", "run_pyqgis"]
    },
    {
      "id": "basemaps_compare_without_adding",
      "trap": true,
      "prompt": "Compare les fonds régionaux pour la Suisse, l'Autriche et la Bretagne. Je veux seulement des propositions, sans ajouter ni télécharger de couche.",
      "expect": [],
      "forbid": ["add_basemap", "add_layer", "add_service_layer", "local_copy", "run_pyqgis"]
    }
  ]
}
