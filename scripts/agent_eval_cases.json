{"cases": [
 {"id": "attr_dept", "prompt": "Ne garde que les communes de Haute-Garonne (département 31).",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["dept", "31"]}},
    "call_args": {"layer_name": "communes", "expression": "\"dept\" = '31'"}}]], "forbid": ["export_layers"]},
 {"id": "attr_population", "prompt": "Show only the municipalities with more than 10000 inhabitants.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["population", "10000"]}},
    "call_args": {"layer_name": "communes", "expression": "\"population\" > 10000"}}]]},
 {"id": "attr_exact_spelling", "prompt": "Filtre les bâtiments résidentiels.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "batiments", "expression": {"contains": ["usage", "Résidentiel"]}},
    "call_args": {"layer_name": "batiments", "expression": "\"usage\" = 'Résidentiel'"}}]]},
 {"id": "attr_two_conditions", "prompt": "Bâtiments industriels de plus de 15 mètres de haut.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "batiments", "expression": {"contains": ["usage", "Industriel", "hauteur", "15"]}},
    "call_args": {"layer_name": "batiments", "expression": "\"usage\" = 'Industriel' AND \"hauteur\" > 15"}}]]},
 {"id": "attr_or_values", "prompt": "Keep motorways and national roads only.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "routes", "expression": {"contains": ["nature", "Autoroute", "Nationale"]}},
    "call_args": {"layer_name": "routes", "expression": "\"nature\" IN ('Autoroute', 'Nationale')"}}]]},
 {"id": "attr_range", "prompt": "Les bâtiments construits entre 1950 et 1975.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "batiments", "expression": {"contains": ["annee", "1950", "1975"]}},
    "call_args": {"layer_name": "batiments", "expression": "\"annee\" BETWEEN 1950 AND 1975"}}]]},
 {"id": "attr_prefix_injection", "prompt": "Filtre les communes dont le nom commence par Saint.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["nom", "Saint"]}},
    "call_args": {"layer_name": "communes", "expression": "\"nom\" LIKE 'Saint%'"}}]], "forbid": ["export_layers"]},
 {"id": "attr_quote_in_value", "prompt": "Parcelles de plus d'un hectare.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "parcelles", "expression": {"contains": ["surface", "10000"]}},
    "call_args": {"layer_name": "parcelles", "expression": "\"surface\" > 10000"}}]]},
 {"id": "attr_intermittent", "prompt": "Show the intermittent streams.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "cours_eau", "expression": {"contains": ["regime", "Intermittent"]}},
    "call_args": {"layer_name": "cours_eau", "expression": "\"regime\" = 'Intermittent'"}}]]},
 {"id": "cross_selected_commune", "prompt": "Filtre les bâtiments qui sont dans la commune sélectionnée.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["batiments"], "predicates": {"any_of": [["Intersect"], ["Are within"]]}},
    "call_args": {"source_layer": "communes", "target_layers": ["batiments"], "predicates": ["Are within"]}}]]},
 {"id": "cross_two_targets", "prompt": "Filter buildings and roads by the selected municipality.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["batiments", "routes"]},
    "call_args": {"source_layer": "communes", "target_layers": ["batiments", "routes"], "predicates": ["Intersect"]}}]]},
 {"id": "cross_buffer", "setup": {"selected": ["routes"]}, "prompt": "Trouve les bâtiments à moins de 50 mètres d'une route sélectionnée.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 50},
    "call_args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 50}}]]},
 {"id": "cross_disjoint", "prompt": "Les parcelles qui ne touchent pas la commune sélectionnée.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["parcelles"], "predicates": ["Disjoint"]},
    "call_args": {"source_layer": "communes", "target_layers": ["parcelles"], "predicates": ["Disjoint"]}}]]},
 {"id": "cross_coverage", "prompt": "Keep parcels with at least 80% of their area inside the selected municipality.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["parcelles"], "coverage_min": 80},
    "call_args": {"source_layer": "communes", "target_layers": ["parcelles"], "coverage_min": 80}}]]},
 {"id": "cross_combine_and", "setup": {"filters": {"batiments": "\"usage\" = 'Résidentiel'"}}, "prompt": "Parmi les bâtiments déjà filtrés, garde seulement ceux dans la commune sélectionnée.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["batiments"], "operator": "AND"},
    "call_args": {"source_layer": "communes", "target_layers": ["batiments"], "operator": "AND"}}]]},
 {"id": "raster_altitude", "prompt": "Les routes au-dessus de 1200 m d'altitude.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "mnt", "target_layers": ["routes"], "raster_selection": {"mode": "range", "minimum": 1200}},
    "call_args": {"source_layer": "mnt", "target_layers": ["routes"], "raster_selection": {"mode": "range", "minimum": 1200}}}]]},
 {"id": "raster_slope", "prompt": "Filter buildings on slopes steeper than 30 degrees.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "mnt", "target_layers": ["batiments"], "raster_selection": {"derivative": "slope_degrees", "minimum": 30}},
    "call_args": {"source_layer": "mnt", "target_layers": ["batiments"], "raster_selection": {"mode": "range", "derivative": "slope_degrees", "minimum": 30}}}]]},
 {"id": "raster_classes", "prompt": "Les parcelles situées en forêt.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "occupation_sol", "target_layers": ["parcelles"], "raster_selection": {"mode": "classes", "classes": [1]}},
    "call_args": {"source_layer": "occupation_sol", "target_layers": ["parcelles"], "raster_selection": {"mode": "classes", "classes": [1]}}}]]},
 {"id": "lidar_buildings", "prompt": "Garde seulement les points LiDAR de la classe bâtiment.",
  "expect": [[{"tool": "point_cloud_filter", "args": {"layers": ["lidar_hd"], "criteria": {"classes": [6]}},
    "call_args": {"layers": ["lidar_hd"], "criteria": {"classes": [6]}}}]]},
 {"id": "lidar_ground_z", "prompt": "Show ground points below 800 m in the point cloud.",
  "expect": [[{"tool": "point_cloud_filter", "args": {"layers": ["lidar_hd"], "criteria": {"any_of": [
      {"classes": [2], "z_max": 800}, {"classes": [2], "expression": {"contains": ["Z", "800"]}}]}},
    "call_args": {"layers": ["lidar_hd"], "criteria": {"classes": [2], "z_max": 800}}}]]},
 {"id": "lidar_by_commune", "prompt": "Découpe le nuage de points sur la commune sélectionnée.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["lidar_hd"]},
    "call_args": {"source_layer": "communes", "target_layers": ["lidar_hd"]}}]]},
 {"id": "geometry_extent", "prompt": "Filtre les bâtiments sur l'emprise actuelle de la carte.",
  "expect": [[{"tool": "geometry_filter", "args": {"target_layers": ["batiments"], "crs": "EPSG:2154", "wkt": {"contains": ["POLYGON", "570000"]}},
    "call_args": {"target_layers": ["batiments"], "crs": "EPSG:2154", "wkt": "POLYGON((570000 6270000, 580000 6270000, 580000 6280000, 570000 6280000, 570000 6270000))"}}]]},
 {"id": "clear_one", "setup": {"filters": {"routes": "\"nature\" = 'Chemin'"}}, "prompt": "Retire le filtre sur les routes.",
  "expect": [[{"tool": "clear_filters", "args": {"layers": ["routes"]}, "call_args": {"layers": ["routes"]}}]]},
 {"id": "clear_two", "setup": {"filters": {"batiments": "\"hauteur\" > 10", "parcelles": "\"surface\" > 1000"}}, "prompt": "Remove the filters on buildings and parcels.",
  "expect": [[{"tool": "clear_filters", "args": {"layers": ["batiments", "parcelles"]}, "call_args": {"layers": ["batiments", "parcelles"]}}]]},
 {"id": "favorite", "prompt": "Applique mon favori Communes denses.",
  "expect": [[{"tool": "apply_favorite", "args": {"favorite_id": "fav-1"}, "call_args": {"favorite_id": "fav-1"}}]]},
 {"id": "export_asked", "prompt": "Exporte les bâtiments en GeoJSON.",
  "expect": [[{"tool": "export_layers", "args": {"layers": ["batiments"], "vector_format": "GeoJSON"},
    "call_args": {"layers": ["batiments"], "vector_format": "GeoJSON"}}]]},
 {"id": "two_steps", "prompt": "Filtre les communes du 31 et exporte-les en GPKG.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["dept", "31"]}},
    "call_args": {"layer_name": "communes", "expression": "\"dept\" = '31'"}},
   {"tool": "export_layers", "args": {"layers": ["communes"], "vector_format": "GPKG"},
    "call_args": {"layers": ["communes"], "vector_format": "GPKG"}}]]},
 {"id": "read_only_question", "prompt": "Quelles couches contient ce projet ?", "expect": [], "forbid": ["export_layers"]},
 {"id": "read_only_fields", "prompt": "Which fields does the roads layer have?", "expect": []},
 {"id": "unknown_layer", "prompt": "Filtre la couche des hôpitaux sur le département 31.", "expect": []},
 {"id": "no_export_unasked", "prompt": "Filtre les routes nationales.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "routes", "expression": {"contains": ["nature", "Nationale"]}},
    "call_args": {"layer_name": "routes", "expression": "\"nature\" = 'Nationale'"}}]], "forbid": ["export_layers"]},
 {"id": "zoom_selected", "prompt": "Zoome sur la commune sélectionnée.",
  "expect": [[{"tool": "zoom_to", "args": {"layer": "communes", "selected_only": true},
    "call_args": {"layer": "communes", "selected_only": true}}]]},
 {"id": "select_then_cross", "prompt": "Sélectionne Toulouse dans les communes puis garde les bâtiments qui sont dedans.",
  "expect": [[{"tool": "select_features", "args": {"layer": "communes", "expression": {"contains": ["nom", "Toulouse"]}},
    "call_args": {"layer": "communes", "expression": "\"nom\" = 'Toulouse'"}},
   {"tool": "cross_filter", "args": {"source_layer": "communes", "target_layers": ["batiments"]},
    "call_args": {"source_layer": "communes", "target_layers": ["batiments"], "predicates": ["Are within"]}}]]},
 {"id": "hide_layer", "prompt": "Hide the parcels layer.",
  "expect": [[{"tool": "set_layers_visibility", "args": {"layers": ["parcelles"], "visible": false},
    "call_args": {"layers": ["parcelles"], "visible": false}}]]},
 {"id": "undo_asked", "prompt": "Annule ce que tu viens de faire.",
  "expect": [[{"tool": "undo_agent_step", "args": {}, "call_args": {}}]], "forbid": ["clear_filters"]},
 {"id": "undo_not_for_a_new_filter", "prompt": "Garde seulement les routes nationales.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "routes", "expression": {"contains": ["nature", "Nationale"]}},
    "call_args": {"layer_name": "routes", "expression": "\"nature\" = 'Nationale'"}}]], "forbid": ["undo_agent_step"]},
 {"id": "cross_nothing_kept", "setup": {"selected": ["routes"], "empty": ["batiments"]},
  "prompt": "Garde les bâtiments qui touchent les routes sélectionnées.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "routes", "target_layers": ["batiments"]},
    "call_args": {"source_layer": "routes", "target_layers": ["batiments"], "predicates": ["Touch"]}}],
   [{"tool": "clear_filters", "args": {"layers": ["batiments"]}, "call_args": {"layers": ["batiments"]}}]]},
 {"id": "cross_every_source_feature", "setup": {"selected": []},
  "prompt": "Garde les bâtiments à moins de 20 mètres d'une route, n'importe laquelle.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 20,
    "selected_only": false},
    "call_args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 20, "selected_only": false}}]]},
 {"id": "narrow_with_and", "setup": {"filters": {"communes": "\"population\" > 10000"}},
  "prompt": "Parmi ces communes, garde seulement celles du département 31.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["dept", "31"]},
    "operator": "AND"},
    "call_args": {"layer_name": "communes", "expression": "\"dept\" = '31'", "operator": "AND"}}]]},
 {"id": "stats_count_by_group", "prompt": "Combien y a-t-il de communes par département ?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "stats_total_length", "prompt": "Quelle est la longueur totale des routes du projet ?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "stats_largest", "prompt": "What is the population of the most populated commune?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "note_kept_on_request", "prompt": "Retiens pour la suite que la couche des parcelles s'appelle parcelles et que sa clé est le champ section.",
  "expect": [[{"tool": "add_project_note", "args": {"text": {"contains": ["parcelles", "section"]}},
    "call_args": {"text": "La couche des parcelles s'appelle parcelles, clé : champ section."}}]],
  "forbid": ["export_layers", "apply_filter"]},
 {"id": "note_not_kept_unasked", "prompt": "Quelles valeurs prend le champ nom des communes ?", "expect": [],
  "forbid": ["add_project_note", "export_layers"]}
]}
