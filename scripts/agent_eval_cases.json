  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 20,
    "selected_only": false},
    "call_args": {"source_layer": "routes", "target_layers": ["batiments"], "buffer": 20, "selected_only": false}}]]},
 {"id": "narrow_with_and", "setup": {"filters": {"communes": "\"population\" > 10000"}},
  "prompt": "Parmi ces communes, garde seulement celles du département 31.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["dept", "31"]},
    "operator": "AND"},
    "call_args": {"layer_name": "communes", "expression": "\"dept\" = '31'", "operator": "AND"}}]]},
 {"id": "stats_count_by_group", "prompt": "Combien y a-t-il de communes par département ?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "stats_total_length", "prompt": "Quelle est la longueur totale des routes du projet ?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "stats_largest", "prompt": "What is the population of the most populated commune?", "expect": [],
  "forbid": ["export_layers", "apply_filter", "select_features"]},
 {"id": "processing_buffer_layer", "prompt": "Crée une nouvelle couche avec une zone tampon de 500 m autour des routes.",
  "expect": [[{"tool": "run_algorithm", "args": {"algorithm_id": "native:buffer", "parameters": {"INPUT": "routes",
    "DISTANCE": 500}}, "call_args": {"algorithm_id": "native:buffer", "parameters": {"INPUT": "routes", "DISTANCE": 500}}}]],
  "forbid": ["export_layers", "remove_layers"]},
 {"id": "processing_centroids", "prompt": "Make a layer of the centroids of the communes.",
  "expect": [[{"tool": "run_algorithm", "args": {"algorithm_id": "native:centroids", "parameters": {"INPUT": "communes"}},
    "call_args": {"algorithm_id": "native:centroids", "parameters": {"INPUT": "communes"}}}]],
  "forbid": ["export_layers", "remove_layers"]},
 {"id": "style_graduated", "prompt": "Colore les communes selon leur population, en 5 classes.",
  "expect": [[{"tool": "set_layer_style", "args": {"layer": "communes", "mode": "graduated", "field": "population"},
    "call_args": {"layer": "communes", "mode": "graduated", "field": "population", "classes": 5}}]],
  "forbid": ["export_layers", "apply_filter", "run_algorithm"]},
 {"id": "labels_names", "prompt": "Show the names of the communes on the map.",
  "expect": [[{"tool": "set_labels", "args": {"layer": "communes", "field": "nom"},
    "call_args": {"layer": "communes", "field": "nom"}}]],
  "forbid": ["export_layers", "apply_filter"]},
 {"id": "dock_objects_cross", "setup": {"drawn": {"orthophoto": 4}},
  "prompt": "Garde seulement les bâtiments qui touchent les objets que j'ai dessinés sur l'orthophoto.",
  "expect": [[{"tool": "cross_filter", "args": {"source_layer": "orthophoto", "target_layers": ["batiments"],
    "raster_selection": {"dock_objects": true}},
    "call_args": {"source_layer": "orthophoto", "target_layers": ["batiments"], "raster_selection": {"dock_objects": true}}}]],
  "forbid": ["segment_objects"]},
 {"id": "dock_objects_none", "prompt": "Filter the roads with the objects I drew on the orthophoto.",
  "expect": [], "forbid": ["segment_objects"]},
 {"id": "sam_from_footprints", "setup": {"selected": ["batiments"]},
  "prompt": "Redessine avec SAM, sur l'orthophoto, les bâtiments sélectionnés.",
  "expect": [[{"tool": "segment_objects", "args": {"raster": "orthophoto", "guide_layer": "batiments"},
    "call_args": {"raster": "orthophoto", "guide_layer": "batiments"}}]]},
 {"id": "note_kept_on_request", "prompt": "Retiens pour la suite que la couche des parcelles s'appelle parcelles et que sa clé est le champ section.",
  "expect": [[{"tool": "add_project_note", "args": {"text": {"contains": ["parcelles", "section"]}},
    "call_args": {"text": "La couche des parcelles s'appelle parcelles, clé : champ section."}}]],
  "forbid": ["export_layers", "apply_filter"]},
 {"id": "note_not_kept_unasked", "prompt": "Quelles valeurs prend le champ nom des communes ?", "expect": [],
  "forbid": ["add_project_note", "export_layers"]},
 {"id": "edit_values", "prompt": "Dans la couche communes, mets le champ dept à 31 pour la commune de Muret.",
  "expect": [[{"tool": "update_features", "args": {"layer": "communes", "values": {"dept": "31"},
    "expression": {"contains": ["nom", "Muret"]}},
    "call_args": {"layer": "communes", "values": {"dept": "31"}, "expression": "\"nom\" = 'Muret'"}}]],
  "forbid": ["export_layers", "apply_filter", "delete_features"]},
 {"id": "hide_is_no_delete", "prompt": "Cache les communes du département 32.",
  "expect": [[{"tool": "apply_filter", "args": {"layer_name": "communes", "expression": {"contains": ["dept", "32"]}},
    "call_args": {"layer_name": "communes", "expression": "\"dept\" <> '32'"}}]],
  "forbid": ["delete_features", "update_features", "export_layers"]}
]}
